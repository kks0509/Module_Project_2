OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# External passive collection (paths on the machine running this app).
EXTERNAL_WEB_LOG_PATH=/home/lms/burp_share/burp_live.log
# Optional discovery settings for CLI/API auto mode; the web UI uses manual input.
EXTERNAL_ZEROTIER_INTERFACE=
EXTERNAL_ZEROTIER_PORT=5000
# Optional initial value for the web UI's editable capture interface field.
EXTERNAL_INTERFACE=
# Secondary discovery fallback for CLI/API auto mode: Docker bridge + IPv4.
EXTERNAL_DOCKER_NETWORK=lms-security-lab_lms-network
EXTERNAL_LMS_CONTAINER=lms-web
EXTERNAL_LMS_PORT=5000
# Ubuntu uses /usr/bin/dumpcap. This setting is for other platforms only.
EXTERNAL_DUMPCAP=/usr/bin/dumpcap
EXTERNAL_TIMEZONE=Asia/Seoul
# Empty: use OPENAI_MODEL. Set to the log team's model if available on your API account.
EXTERNAL_OPENAI_MODEL=
